<Page x:Class="Bootrix.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:Bootrix.App.Localization"
      Title="{loc:Loc Settings.Title}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="760" HorizontalAlignment="Left">
            <ui:TextBlock Text="{loc:Loc Settings.Title}" FontTypography="Title" Margin="0,0,0,20" />

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <ui:TextBlock Text="{loc:Loc Settings.Language}" />
                </ui:CardControl.Header>
                <ComboBox MinWidth="200"
                          ItemsSource="{Binding Languages}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding Language}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <ui:TextBlock Text="{loc:Loc Settings.Theme}" />
                </ui:CardControl.Header>
                <ComboBox MinWidth="200"
                          ItemsSource="{Binding Themes}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Theme"
                          SelectedValue="{Binding Theme}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Loc Settings.ShowUsbHdd}" />
                        <ui:TextBlock Text="{loc:Loc Settings.ShowUsbHdd.Hint}" Appearance="Secondary" FontTypography="Caption" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ShowUsbHardDisks}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Loc Settings.ServiceMode}" />
                        <ui:TextBlock Text="{loc:Loc Settings.ServiceMode.Hint}" Appearance="Secondary" FontTypography="Caption" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ServiceMode}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <ui:TextBlock Text="{loc:Loc Settings.Verify}" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding VerifyAfterWrite}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <ui:TextBlock Text="{loc:Loc Settings.Sound}" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding PlaySoundWhenDone}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Loc Settings.TeamProfiles}" />
                        <ui:TextBlock Text="{loc:Loc Settings.TeamProfiles.Hint}" Appearance="Secondary" FontTypography="Caption" TextWrapping="Wrap" />
                        <ui:TextBlock Text="{Binding TeamProfileDirectory}" FontTypography="Caption" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                      Visibility="{Binding HasTeamProfileDirectory, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{loc:Loc Settings.Browse}" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding PickTeamProfileDirectoryCommand}" />
                    <ui:Button Content="{loc:Loc Settings.Clear}" Margin="8,0,0,0" Command="{Binding ClearTeamProfileDirectoryCommand}"
                               Visibility="{Binding HasTeamProfileDirectory, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Loc Settings.Diagnostics}" />
                        <ui:TextBlock Text="{loc:Loc Settings.Diagnostics.Hint}" Appearance="Secondary" FontTypography="Caption" TextWrapping="Wrap" />
                        <ui:TextBlock Text="{Binding DiagnosticsStatus}" FontTypography="Caption" TextWrapping="Wrap" Margin="0,4,0,0"
                                      Visibility="{Binding HasDiagnosticsStatus, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{loc:Loc Settings.Diagnostics.OpenLogs}" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogFolderCommand}" />
                    <ui:Button Content="{loc:Loc Settings.Diagnostics.Create}" Icon="{ui:SymbolIcon Save24}" Margin="8,0,0,0" Command="{Binding CreateDiagnosticsCommand}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Loc Settings.About}" />
                        <ui:TextBlock Text="{Binding AboutText}" Appearance="Secondary" FontTypography="Caption" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{loc:Loc Settings.About.Source}" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenSourcePageCommand}" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
