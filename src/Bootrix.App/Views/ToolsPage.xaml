<Page x:Class="Bootrix.App.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:Bootrix.App.Localization"
      xmlns:controls="clr-namespace:Bootrix.App.Controls"
      Title="{loc:Loc Tools.Title}"
      AllowDrop="True"
      DragOver="OnDragOver"
      Drop="OnDrop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="900" HorizontalAlignment="Stretch">
            <ui:TextBlock Text="{loc:Loc Tools.Title}" FontTypography="Title" Margin="0,0,0,8" />
            <ui:TextBlock Text="{loc:Loc Tools.Intro}" Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,20" />

            <ui:TextBlock Text="{loc:Loc Tools.Tool}" FontTypography="Subtitle" Margin="0,0,0,8" />
            <ComboBox MinWidth="360" HorizontalAlignment="Left" Margin="0,0,0,8"
                      ItemsSource="{Binding Tools}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedTool}" />
            <ui:TextBlock Text="{Binding Hint}" Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,24" />

            <!-- Verify -->
            <StackPanel Visibility="{Binding IsVerify, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Text="{loc:Loc Tools.Verify.Image}" FontTypography="Subtitle" Margin="0,0,0,8" />
                <Border Padding="16" CornerRadius="6" Margin="0,0,0,16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock Text="{Binding ImagePath}" TextTrimming="CharacterEllipsis" />
                            <ui:TextBlock Text="{loc:Loc Write.ImagePlaceholder}" Appearance="Secondary"
                                          Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="{loc:Loc Write.Browse}" Icon="{ui:SymbolIcon FolderOpen24}"
                                   Command="{Binding PickImageCommand}" Margin="16,0,0,0" />
                    </Grid>
                </Border>
                <ui:TextBlock Text="{loc:Loc Tools.Verify.Mode}" FontTypography="BodyStrong" Margin="0,0,0,4" />
                <ComboBox MinWidth="280" HorizontalAlignment="Left" Margin="0,0,0,24"
                          ItemsSource="{Binding Modes}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedMode}" />
            </StackPanel>

            <!-- Restore -->
            <StackPanel Visibility="{Binding IsRestore, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,0,0,24" MaxWidth="560" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" Text="{loc:Loc Tools.Restore.Scheme}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" MinWidth="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding Schemes}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedScheme}" />
                    <ui:TextBlock Grid.Row="1" Text="{loc:Loc Tools.Restore.FileSystem}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" MinWidth="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding FileSystems}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedFileSystem}" />
                    <ui:TextBlock Grid.Row="2" Text="{loc:Loc Tools.Restore.Label}" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="2" Grid.Column="1" MaxLength="32" MinWidth="200" HorizontalAlignment="Left"
                                Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>

            <!-- Stick test -->
            <StackPanel Visibility="{Binding IsTest, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Text="{loc:Loc Tools.Test.Mode}" FontTypography="BodyStrong" Margin="0,0,0,4" />
                <ComboBox MinWidth="420" HorizontalAlignment="Left" Margin="0,0,0,24"
                          ItemsSource="{Binding TestModes}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedTestMode}" />
            </StackPanel>

            <controls:DeviceList DataContext="{Binding Devices}" />

            <ui:Button Content="{Binding StartText}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                       Command="{Binding StartCommand}" MinWidth="140" HorizontalAlignment="Left" Margin="0,0,0,16" />

            <controls:JobProgressPanel DataContext="{Binding Job}" />
            <StackPanel Visibility="{Binding HasTestResults, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                <ui:TextBlock Text="{loc:Loc Tools.Test.Results}" FontTypography="Subtitle" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding TestResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16" CornerRadius="6" Margin="0,0,0,8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <ui:TextBlock Text="{Binding VerdictText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Verdict}" Value="FakeCapacity">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Verdict}" Value="BadBlocks">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBlock Text="{Binding Label}" Appearance="Secondary" />
                                                    <ui:TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
