<Page x:Class="Bootrix.App.Views.WritePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:Bootrix.App.Localization"
      Title="{loc:Loc Write.Title}"
      AllowDrop="True"
      DragOver="OnDragOver"
      Drop="OnDrop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="900" HorizontalAlignment="Stretch">
            <ui:TextBlock Text="{loc:Loc Write.Title}" FontTypography="Title" Margin="0,0,0,20" />

            <!-- Image -->
            <ui:TextBlock Text="{loc:Loc Write.Image}" FontTypography="Subtitle" Margin="0,0,0,8" />
            <Border Padding="16" CornerRadius="6" Margin="0,0,0,24"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="{Binding ImagePath}" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Text="{loc:Loc Write.ImagePlaceholder}" Appearance="Secondary">
                            <ui:TextBlock.Style>
                                <Style TargetType="ui:TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ImagePath}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:TextBlock.Style>
                        </ui:TextBlock>
                        <ui:TextBlock Text="{Binding ImageInfo}" Appearance="Secondary" FontTypography="Caption" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="{loc:Loc Write.Browse}" Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding BrowseCommand}" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- Drives -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="{loc:Loc Write.Drives}" FontTypography="Subtitle" VerticalAlignment="Center" />
                    <ui:TextBlock Text="{Binding SelectedText}" Appearance="Secondary" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="{loc:Loc Write.Refresh}" Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RefreshCommand}" />
            </Grid>

            <ui:TextBlock Text="{loc:Loc Write.NoDrives}" Appearance="Secondary" Margin="0,8,0,16">
                <ui:TextBlock.Style>
                    <Style TargetType="ui:TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDevices}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:TextBlock.Style>
            </ui:TextBlock>

            <ItemsControl ItemsSource="{Binding Devices}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,6" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" MinWidth="0"
                                          IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" />
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <ui:TextBlock Text="{Binding Description.Title}" FontWeight="SemiBold" />
                                    <ui:TextBlock Text="{Binding Description.Details}" Appearance="Secondary" FontTypography="Caption" TextWrapping="Wrap" />
                                    <ui:TextBlock Text="{Binding Description.BlockReason}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                  FontTypography="Caption" TextWrapping="Wrap">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                    <ui:TextBlock Text="{Binding Description.Warning}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                  FontTypography="Caption" TextWrapping="Wrap">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                </StackPanel>
                                <ui:TextBlock Grid.Column="2" Text="{Binding Description.SizeText}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Preview of the plan -->
            <ui:TextBlock Text="{loc:Loc Plan.Heading}" FontTypography="Subtitle" Margin="0,8,0,8" />
            <Border Padding="16" CornerRadius="6" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <ui:TextBlock Text="{Binding PreviewMessage}" Appearance="Secondary" TextWrapping="Wrap"
                                  Visibility="{Binding HasPreviewMessage, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding PreviewLines}"
                                  Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{Binding Label}" Appearance="Secondary" />
                                    <ui:TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding PreviewWarnings}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,4" FontTypography="Caption">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Options -->
            <Expander Header="{loc:Loc Opt.Heading}" Margin="0,0,0,16">
                <StackPanel Margin="0,8,0,0" DataContext="{Binding Options}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:TextBlock Text="{loc:Loc Opt.Mode}" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <ComboBox Grid.Column="1" Margin="0,0,0,8" MinWidth="260" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Modes}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />

                        <ui:TextBlock Grid.Row="1" Text="{loc:Loc Opt.Scheme}" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" MinWidth="260" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Schemes}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Scheme}" />

                        <ui:TextBlock Grid.Row="2" Text="{loc:Loc Opt.Firmware}" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" MinWidth="260" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Firmwares}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Firmware}" />

                        <ui:TextBlock Grid.Row="3" Text="{loc:Loc Opt.FileSystem}" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" MinWidth="260" HorizontalAlignment="Left"
                                  ItemsSource="{Binding FileSystems}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding FileSystem}" />

                        <ui:TextBlock Grid.Row="4" Text="{loc:Loc Opt.Label}" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <ui:TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" MinWidth="260" MaxLength="32" HorizontalAlignment="Left"
                                    Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:TextBlock Grid.Row="5" Text="{loc:Loc Opt.Persistence}" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <ui:TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" MinWidth="120" HorizontalAlignment="Left"
                                    Text="{Binding PersistenceMegabytes, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <CheckBox Content="{loc:Loc Opt.LegacyBios}" IsChecked="{Binding LegacyBios}" Margin="0,0,0,8" />

                    <StackPanel Visibility="{Binding IsWindowsImage, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                        <ui:TextBlock Text="{loc:Loc Opt.Windows.Heading}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                        <CheckBox Content="{loc:Loc Opt.Windows.BypassTpm}" IsChecked="{Binding BypassTpm}" />
                        <CheckBox Content="{loc:Loc Opt.Windows.BypassSecureBoot}" IsChecked="{Binding BypassSecureBoot}" />
                        <CheckBox Content="{loc:Loc Opt.Windows.BypassRam}" IsChecked="{Binding BypassRam}" />
                        <CheckBox Content="{loc:Loc Opt.Windows.BypassCpu}" IsChecked="{Binding BypassCpu}" />
                        <CheckBox Content="{loc:Loc Opt.Windows.BypassStorage}" IsChecked="{Binding BypassStorage}" />
                        <CheckBox Content="{loc:Loc Opt.Windows.SkipPrivacy}" IsChecked="{Binding SkipPrivacyQuestions}" />
                        <CheckBox Content="{loc:Loc Opt.Windows.DisableBitLocker}" IsChecked="{Binding DisableBitLocker}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="{loc:Loc Opt.Windows.LocalAccount}" VerticalAlignment="Center" />
                            <ui:TextBox Grid.Column="1" MinWidth="260" MaxLength="20" HorizontalAlignment="Left"
                                        Text="{Binding LocalAccountName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <CheckBox Content="{loc:Loc Write.Verify}" IsChecked="{Binding Verify}" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ui:Button Content="{loc:Loc Write.Start}" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                           Command="{Binding StartCommand}" MinWidth="140" />
                <ui:Button Content="{Binding CancelText}" Icon="{ui:SymbolIcon Stop24}" Margin="8,0,0,0"
                           Command="{Binding CancelCommand}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Progress -->
            <StackPanel Margin="0,0,0,16" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="{Binding ProgressTitle}" />
                    <ui:TextBlock Grid.Column="1" Appearance="Secondary">
                        <Run Text="{Binding SpeedText, Mode=OneWay}" />
                        <Run Text="  " />
                        <Run Text="{Binding RemainingText, Mode=OneWay}" />
                    </ui:TextBlock>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="6" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Result -->
            <ui:InfoBar IsOpen="{Binding HasResult, Mode=OneWay}" IsClosable="False"
                        Title="{Binding ResultTitle}" Message="{Binding ResultMessage}"
                        Severity="{Binding ResultSeverity}" />
        </StackPanel>
    </ScrollViewer>
</Page>
