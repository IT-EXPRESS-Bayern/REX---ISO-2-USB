<UserControl x:Class="Bootrix.App.Controls.JobProgressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <StackPanel Margin="0,0,0,16" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="{Binding ProgressTitle}" />
                <ui:TextBlock Grid.Column="1" Appearance="Secondary" VerticalAlignment="Center">
                    <Run Text="{Binding SpeedText, Mode=OneWay}" />
                    <Run Text="  " />
                    <Run Text="{Binding RemainingText, Mode=OneWay}" />
                </ui:TextBlock>
                <ui:Button Grid.Column="2" Content="{Binding CancelText}" Icon="{ui:SymbolIcon Stop24}" Margin="12,0,0,0"
                           Command="{Binding CancelCommand}" />
            </Grid>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="6" Margin="0,8,0,0" />
        </StackPanel>

        <ui:InfoBar IsOpen="{Binding HasResult, Mode=OneWay}" IsClosable="False"
                    Title="{Binding ResultTitle}" Message="{Binding ResultMessage}"
                    Severity="{Binding ResultSeverity}" />
    </StackPanel>
</UserControl>
