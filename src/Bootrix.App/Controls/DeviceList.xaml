<UserControl x:Class="Bootrix.App.Controls.DeviceList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Bootrix.App.Localization">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:TextBlock Text="{loc:Loc Write.Drives}" FontTypography="Subtitle" VerticalAlignment="Center" />
                <ui:TextBlock Text="{Binding SelectedText}" Appearance="Secondary" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="{loc:Loc Write.Refresh}" Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding RefreshCommand}" />
        </Grid>

        <ui:TextBlock Text="{loc:Loc Write.NoDrives}" Appearance="Secondary" Margin="0,0,0,8"
                      Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibility}}" />
        <ui:TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
            <ui:TextBlock.Style>
                <Style TargetType="ui:TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:TextBlock.Style>
        </ui:TextBlock>

        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Center" MinWidth="0"
                                      IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" />
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <ui:TextBlock Text="{Binding Description.Title}" FontWeight="SemiBold" />
                                <ui:TextBlock Text="{Binding Description.Details}" Appearance="Secondary" FontTypography="Caption" TextWrapping="Wrap" />
                                <ui:TextBlock Text="{Binding Description.BlockReason}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                              FontTypography="Caption" TextWrapping="Wrap">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                                <ui:TextBlock Text="{Binding Description.Warning}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                              FontTypography="Caption" TextWrapping="Wrap">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                            </StackPanel>
                            <ui:TextBlock Grid.Column="2" Text="{Binding Description.SizeText}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
