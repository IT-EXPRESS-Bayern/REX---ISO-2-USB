<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>Bootrix.App</RootNamespace>
    <AssemblyName>Bootrix</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <StartupObject>Bootrix.App.Program</StartupObject>
    <ApplicationIcon>..\..\assets\branding\bootrix.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.Main starts the app itself so the same executable can run as the elevated broker. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\branding\bootrix.png" Link="Assets\bootrix.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF SDK drops this one from the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bootrix.Core\Bootrix.Core.csproj" />
    <ProjectReference Include="..\Bootrix.Windows\Bootrix.Windows.csproj" />
  </ItemGroup>

  <Import Project="..\..\build\native-assets.props" />

</Project>
