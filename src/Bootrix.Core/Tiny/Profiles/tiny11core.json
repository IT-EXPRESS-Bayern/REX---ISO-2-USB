{
  "id": "tiny11core",
  "name": "Tiny11 Core",
  "windowsFamily": "11",
  "extends": "tiny11",
  "breaksServicing": true,
  "description": "Wie Tiny11, zusätzlich ohne Komponentenspeicher, Wiederherstellungsumgebung, Defender, Internet Explorer, WordPad und Sprachfunktionen. Das Image lässt sich danach nicht mehr aktualisieren und keine Features oder Sprachen nachinstallieren.",
