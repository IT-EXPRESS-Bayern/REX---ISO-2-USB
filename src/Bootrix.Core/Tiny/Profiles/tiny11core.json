      "kind": "Text",
      "value": "net stop wuauserv",
      "group": "windows-update"
    },
    {
      "hive": "Software",
      "key": "Microsoft\\Windows\\CurrentVersion\\RunOnce",
      "name": "StopWUPostOOBE2",
      "kind": "Text",
      "value": "sc stop wuauserv",
      "group": "windows-update"
